{
  "expo": {
    "name": "ManuCar",
    "slug": "manu-car",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-ManuCar.png",
    "scheme": "manucar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/icon-ManuCar.png",
      "bundleIdentifier": "com.gilberto.manucar",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CCFBF1",
        "foregroundImage": "./assets/icons/icon-ManuCar-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gilberto.manucar",
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/icons/icon-notification.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/icons/icon-ManuCar.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B1120",
            "image": "./assets/icons/icon-ManuCar.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon-notification.png",
          "color": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7bb9594a-ed77-486b-95c3-f889557ed5f1"
      }
    }
  }
}
